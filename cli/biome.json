{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!**/node_modules", "!**/dist", "!**/*.lockb", "!**/*.svg"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@beauty-crm/*-frontend", "@beauty-crm/*-backend"],
                "message": "❌ tdk-cli is a leaf dev tool: it must never import a beauty-crm service/frontend. See BOUNDARIES.md §4-5."
              },
              {
                "group": ["@tdk-landscape/*-backend", "@tdk-landscape/*-frontend"],
                "message": "❌ tdk-cli is a leaf dev tool: it must never import a service package. See BOUNDARIES.md §4-5."
              }
            ]
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    },
    "enabled": true
  }
}
