print("🚀 Loading {{project.name}}...")

# =============================================================================
# 📦 REGISTER TDK EXTENSION
# =============================================================================
# The TDK Tilt extension (engine, discovery, specs, ext) is vendored into
# this project at generation time (.tdk/.tdk-out/tdk-cli-ext). Resolution:
#   1. Vendored in-project copy (default - works offline, no GitHub needed)
#   2. $TDK_EXTENSION_PATH (explicit override to any tdk-cli checkout)
#   3. Clear failure with instructions (no endless git retry on a missing repo)
_vendored_tdk_path = config.main_dir + "/tdk-cli-ext"
_use_local = False
_local_tdk_path = ""

if str(local("test -d " + _vendored_tdk_path + " && echo yes || echo no", quiet=True, echo_off=True)).strip() == 'yes':
    _use_local = True
    _local_tdk_path = _vendored_tdk_path
else:
    _env_tdk_path = os.environ.get('TDK_EXTENSION_PATH', '')
    if len(_env_tdk_path) > 0 and str(local("test -d " + _env_tdk_path + " && echo yes || echo no", quiet=True, echo_off=True)).strip() == 'yes':
        _use_local = True
        _local_tdk_path = _env_tdk_path

if not _use_local:
    fail("""
TDK extension not found.

'tdk up' needs the TDK Tilt extension (engine/discovery/specs/ext).
Fix it with one of:
  1) Regenerate the project so the extension is vendored in:
       tdk project --yes
     (set $TDK_EXTENSION_SOURCE to a tdk-cli checkout if it was not auto-detected)
  2) Point at any tdk-cli checkout:
       export TDK_EXTENSION_PATH=/path/to/tdk-cli
  3) Follow the sandbox guide: https://tdk-landscape.github.io/tdk-website/sandbox/
""")

v1alpha1.extension_repo(name='tdk-cli-local', url='file://' + _local_tdk_path)
v1alpha1.extension(name='tdk-cli', repo_name='tdk-cli-local', repo_path='')

# =============================================================================
# 📍 PROJECT CONFIGURATION
# =============================================================================
# Tiltfile is in .tdk/.tdk-out/, project root is two levels up
PROJECT_ROOT = config.main_dir + "/../.."
os.environ['TDK_PROJECT_ROOT'] = PROJECT_ROOT

# =============================================================================
# 🔌 LOAD MASTER CONFIGS & TDK MODULES
# =============================================================================
load("TILT_TECH_STACK.star",
'assert_tech_stack',
'TECH_STACK',
)
load("TILT_RESOURCE_DEFAULTS.star",
'BASE_PORT_FRONTEND',
'BASE_PORT_BACKEND',
)
load("spec.master",
'RESOURCE_DEFAULTS',
'PRE_ALPHA_RESOURCES',
'ALPHA_RESOURCES',
'BETA_RESOURCES',
'FOCUS_PRE_ALPHA',
'FOCUS_ALPHA',
'FOCUS_BETA',
)

# Load TDK extension modules
load('ext://tdk-cli',
'Utils',
'Manifest',
'Config',
'Orchestrator',
'Watchers',
'Infra',
'Docker',
'load_ui_enhancements',
'APP_RESOURCES',
'GLOBAL_CONFIG_EXPORT',
'Registry',
)

# =============================================================================
# 🏗️ VALIDATE & INITIALIZE
# =============================================================================
assert_tech_stack({
    "bundler": TECH_STACK['bundler'],
    "runtime": TECH_STACK['runtime'],
    "orm": TECH_STACK['orm'],
    "messaging": TECH_STACK['messaging'],
})

# =============================================================================
# 🎨 UI ENHANCEMENTS
# =============================================================================
load_ui_enhancements({
'enable_tooltips': True,
'enable_icons': True,
'enable_help_panel': True,
'enable_cron_jobs_tab': True,
})

# =============================================================================
# 📋 PARSE CLI ARGUMENTS
# =============================================================================
config.define_string_list('focus', usage='Services to focus on')
config.define_bool('no-frontend', usage='Skip frontend services')
config.define_bool('include-monitoring', usage='Include monitoring stack')
config.define_string_list('verbose', usage='Verbose logging')
config.define_bool('no-auto-init-new', usage='Do not auto-init new services')

for resource_name in RESOURCE_DEFAULTS.keys():
    config.define_bool(resource_name, usage='Enable ' + resource_name)

config.define_string_list('args', args=True, usage='Positional arguments')
cfg = config.parse()

# =============================================================================
# 🔮 AUTO-DISCOVERY
# =============================================================================
_AUTO_DISCOVER_ENABLED = os.environ.get('AUTO_DISCOVER', 'true').lower() == 'true'
_DISCOVERY_SCAN_INTERVAL = int(os.environ.get('DISCOVERY_SCAN_INTERVAL', '5'))
_AUTO_INIT_NEW_RESOURCES = not cfg.get('no-auto-init-new', False)

# Auto-discovery enabled ({{discovery.interval}}s interval)
_AUTO_DISCOVER_ENABLED = _AUTO_DISCOVER_ENABLED

# =============================================================================
# 📝 LOGGING
# =============================================================================
_LOG_LEVEL = "verbose" if (cfg.get('verbose') or os.environ.get('VERBOSE', '').lower() == 'true') else "normal"

def get_log_level():
    return _LOG_LEVEL

def is_verbose():
    return _LOG_LEVEL == "verbose"

os.environ['TILT_LOG_LEVEL'] = _LOG_LEVEL
if _LOG_LEVEL == "verbose":
    os.environ['VERBOSE'] = 'true'

# =============================================================================
# 🌍 ENVIRONMENT SETUP
# =============================================================================
is_macos = str(local('uname -s', quiet=True)).strip() == 'Darwin'
Utils.load_dotenv(PROJECT_ROOT)

# =============================================================================
# 🎯 FOCUS MODE
# =============================================================================
FOCUS_MODE, FOCUS_ENABLED_ALL, FOCUS_ENABLED_RESOURCES = Config.apply_focus(cfg)
# Load ALWAYS_ENABLED_INFRA from project.json (falls back to defaults if not specified)
ALWAYS_ENABLED_INFRA = {{starlarkArray alwaysEnabledInfra}}

def should_enable(resource_name):
    if FOCUS_MODE and resource_name in ALWAYS_ENABLED_INFRA:
        return RESOURCE_DEFAULTS.get(resource_name, True)
    if FOCUS_MODE and FOCUS_ENABLED_ALL:
        if resource_name in FOCUS_ENABLED_ALL:
            return True
        for domain in FOCUS_ENABLED_ALL:
            if resource_name.startswith(domain + "-"):
                return True
    return Utils.should_enable(resource_name, cfg, RESOURCE_DEFAULTS)

# =============================================================================
# 🏗️ INFRASTRUCTURE SERVICES
# =============================================================================

print("🏗️  Loading infrastructure services...")
Infra.load_all(
    should_enable=should_enable,
    fix_docker_networks_fn=Utils.fix_docker_networks,
    docker_provider=Docker,
    write_fn=Utils.write_file_if_changed,
    project_root=PROJECT_ROOT,
)

# =============================================================================
# 📚 INITIALIZE TDK
# =============================================================================
print("🚀 Initializing TDK...")

# Use pre-loaded APP_RESOURCES from TDK registry (already initialized with all services)
# Registry.reinitialize() is only needed if we want to force a fresh discovery
_app_resources_list = APP_RESOURCES

# First run or cache cleared — build registry from manifests
if len(_app_resources_list) == 0:
    _app_resources_list = Registry.reinitialize()

# If still empty, load directly from manifest files
if len(_app_resources_list) == 0:
    _app_resources_list = Manifest.load_all(PROJECT_ROOT)

print("📦 Loaded {} services".format(len(_app_resources_list)))

# Create Tilt resources for all services
TILT_CONTEXT = {
    'should_enable': should_enable,
    'write_file': Utils.write_file_if_changed,
    'global_config': GLOBAL_CONFIG_EXPORT,
    'project_root': PROJECT_ROOT,
    'all_services': _app_resources_list,
}

print("🚀 Creating Tilt resources for {} services...".format(len(_app_resources_list)))
for app_service in _app_resources_list:
    Orchestrator.apply_service(app_service, TILT_CONTEXT)

# Setup file watchers
Watchers.setup_package_json(_app_resources_list, should_enable)

# Apply focus mode filter
# Build known Tilt resource names from discovered services to filter focus list
_KNOWN_TILT_RESOURCES = set()
_KNOWN_TILT_RESOURCES.add('service-discovery-daemon')
_KNOWN_TILT_RESOURCES.add('init-networks')
_KNOWN_TILT_RESOURCES.add('postgres')
_KNOWN_TILT_RESOURCES.add('nats')
_KNOWN_TILT_RESOURCES.add('infisical')
_KNOWN_TILT_RESOURCES.add('infisical-db')
_KNOWN_TILT_RESOURCES.add('infisical-redis')
_KNOWN_TILT_RESOURCES.add('traefik')
_KNOWN_TILT_RESOURCES.add('verdaccio')
_KNOWN_TILT_RESOURCES.add('golden-layers-build')
for _KNOWN_SVC in _app_resources_list:
    _KNOWN_SVC_NAME = _KNOWN_SVC.get('name', '')
    if _KNOWN_SVC_NAME:
        for _KNOWN_RES in _KNOWN_SVC.get('resources', []):
            _KNOWN_RES_NAME = _KNOWN_RES.get('name', '')
            if _KNOWN_RES_NAME:
                _KNOWN_TILT_RESOURCES.add(_KNOWN_RES_NAME)
                _KNOWN_TILT_RESOURCES.add(_KNOWN_RES_NAME + '-run-only')
                _KNOWN_TILT_RESOURCES.add(_KNOWN_RES_NAME + '-config-gen')
if FOCUS_MODE and FOCUS_ENABLED_RESOURCES:
    _FILTERED_RESOURCES = []
    for _R in FOCUS_ENABLED_RESOURCES:
        if _R in _KNOWN_TILT_RESOURCES:
            _FILTERED_RESOURCES.append(_R)
        else:
            _MATCHED = [kr for kr in _KNOWN_TILT_RESOURCES if kr != 'service-discovery-daemon' and kr.startswith(_R + '-')]
            _FILTERED_RESOURCES.extend(_MATCHED)
    _FILTERED_RESOURCES = sorted(set(_FILTERED_RESOURCES))
    if _FILTERED_RESOURCES:
        config.set_enabled_resources(_FILTERED_RESOURCES)
        print("🎯 Focus mode: {} resources".format(len(_FILTERED_RESOURCES)))
    else:
        print("⚠️  No known resources matched focus targets:", ", ".join(FOCUS_ENABLED_RESOURCES))

# =============================================================================
# 👁️ AUTO-DISCOVERY DAEMON
# =============================================================================
if _AUTO_DISCOVER_ENABLED:
    watch_file('snapshots/resource-snapshot.json')
    
    # Get extension install path: vendored copy inside this project
    discovery_path = _local_tdk_path + "/discovery"

    daemon_script = discovery_path + '/resource_snapshot.py'
    daemon_cmd = "cd " + config.main_dir + " && python3 \"" + daemon_script + "\" watch"
    
    local_resource('service-discovery-daemon',
        serve_cmd=daemon_cmd,
        deps=[daemon_script],
        auto_init=True, labels=['discovery'],
        links=[link('file:///snapshots/resource-snapshot.json', 'Resource Snapshot')]
    )
    


print("\n✅ {{project.name}} Tilt ready!")
