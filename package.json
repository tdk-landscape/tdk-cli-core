{
  "name": "@tdk-landscape/tdk-cli-core",
  "version": "1.3.49",
  "description": "Run 100 microservices on a 16 GB laptop without Kubernetes. Scaffold services and run them locally with hot reload, built on Tilt.",
  "homepage": "https://tdk-landscape.github.io/tdk-website",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tdk-landscape/tdk-cli-core.git"
  },
  "bugs": {
    "url": "https://github.com/tdk-landscape/tdk-cli-core/issues"
  },
  "private": false,
  "workspaces": [
    "cli"
  ],
  "bin": {
    "tdk": "cli/bin/tdk.js",
    "tdk-cli": "cli/bin/tdk.js"
  },
  "scripts": {
    "build": "cd cli && npm run build",
    "build:watch": "cd cli && npm run build:watch",
    "typecheck": "cd cli && npm run typecheck",
    "lint": "cd cli && npm run lint",
    "lint:fix": "cd cli && npm run lint:fix",
    "test": "cd cli && npm run test",
    "clean": "cd cli && npm run clean",
    "release:binaries": "scripts/release-binaries.sh",
    "release:binaries:publish": "scripts/release-binaries.sh --publish",
    "prepare": "scripts/install-git-hooks.sh",
    "cli": "cd cli && node bin/tdk.js",
    "tdk": "cd cli && node bin/tdk.js"
  },
  "keywords": [
    "tdk",
    "tilt",
    "cli",
    "microservices",
    "local-dev",
    "local-development",
    "developer-tools",
    "developer-experience",
    "docker",
    "docker-compose",
    "dev-environment",
    "monorepo",
    "hot-reload",
    "bun",
    "kubernetes-alternative"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "knip": "^6.9.0"
  }
}
