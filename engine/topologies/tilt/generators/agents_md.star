# =============================================================================
# 🤖 TILT SDK - AGENTS.MD GENERATOR
# =============================================================================
# Path: .tilt/providers/generators/agents_md.star
# Purpose: Generate AGENTS.md for .autogenerated/ folder to instruct AI agents
# =============================================================================
#
# This generator creates an AGENTS.md file inside each resource's .autogenerated/
# folder. The generated file warns AI agents not to modify autogenerated files
# and explains why - preventing confusion about the single source of truth.
#
# Generated file location:
#   {resource_path}/.autogenerated/AGENTS.md
#
# Why this matters:
# - Agents must NOT modify files in .autogenerated/ (they're overwritten)
# - Agents MUST modify source files that generators use as input
# - This file serves as a "guard rail" for AI agent behavior
# =============================================================================


# === INLINED CONSTANTS for pure extension loading ===
OUTPUT = struct(AUTOGENERATED_FOLDER = ".autogenerated")
# === END INLINED CONSTANTS ===


load('../../../topologies/tilt/common/utils.star', 'Utils')

# =============================================================================
# 📝 AGENTS.MD TEMPLATE
# =============================================================================

TEMPLATE_AGENTS_MD = """---
disable: false
description: Auto-generated warning for AI agents - DO NOT MODIFY files in this folder. This is a machine-generated guard rail to prevent accidental edits to ephemeral configuration files.
title: Autogenerated Files - DO NOT MODIFY
status: autogenerated
created: {timestamp}
updated: {timestamp}
---

# ⚠️ AUTOGENERATED FILES - DO NOT MODIFY

**This folder (`.autogenerated/`) contains MACHINE-GENERATED files.**

Any changes you make here **will be overwritten** the next time Tilt runs the configuration generators. This is by design.

## Why This Folder Exists

The `.autogenerated/` folder is part of TDK Landscape's manifest-driven architecture:

1. **Single Source of Truth**: Your `service.json` (manifest) is the ONLY source of truth
2. **1 Manifest → 1 Resource → 10+ Generators**: Each manifest triggers generators that create:
   - `vite.config.*.autogenerated.ts` - Build configuration
   - `tsconfig.*.autogenerated.json` - TypeScript configuration
   - `Dockerfile.*.autogenerated` - Container images
   - `nginx.autogenerated.conf` - Reverse proxy rules
   - `.env.*.autogenerated` - Environment variables
   - `bunfig.*.autogenerated.toml` - Package manager config
   - `.npmrc.*.autogenerated` - Registry configuration
   - `docker-compose.*.autogenerated.yml` - Container orchestration
   - `playwright.config.autogenerated.ts` - Test configuration
   - `prisma.config.autogenerated.ts` - Database ORM config

3. **Atomic Updates**: All files in this folder are regenerated together as an atomic transaction
4. **Ephemeral by Design**: These files should NOT be committed to git (they're in `.gitignore`)

## What Happens If You Modify Files Here

```
❌ You edit:    .autogenerated/vite.config.backend.autogenerated.ts
❌ Result:      Changes lost on next Tilt up
❌ Impact:      Wasted time, confusion, bugs

✅ You edit:    service.json (add "vite-node" to features)
✅ Result:      Generator updates vite.config.* automatically
✅ Impact:      Persistent change, properly tracked
```

## Where to Make Changes Instead

| If you want to change... | Edit this file instead |
|--------------------------|------------------------|
| Port, features, appType | `service.json` |
| Dependencies | `package.json` |
| Source code | `src/` folder |
| Environment variables | `service.json` → `envVars` |
| Build settings | `service.json` → `features` array |
| Docker settings | `service.json` → `docker` section |
| Internal dependencies | `service.json` → `internalDependencies` |

## How Regeneration Works

```
service.json (source of truth)
    ↓
Tilt config-gen resource (watches manifest)
    ↓
Generators (tsconfig.star, vite_config.star, dockerfile.star...)
    ↓
.autogenerated/*.autogenerated.* (this folder)
    ↓
Docker build uses these files
```

## For AI Agents

**CRITICAL INSTRUCTIONS:**

1. **NEVER** use `write()` or `edit()` on files in `.autogenerated/`
2. **ALWAYS** check if a file path contains `.autogenerated/` before modifying
3. **ALWAYS** trace back to the source manifest (`service.json`)
4. **USE** `skill('autogenerated-files-workflow')` when working with topology changes

**Pattern to follow:**
```starlark
# ❌ WRONG - Directly editing autogenerated
write_file(".autogenerated/vite.config.backend.autogenerated.ts", content)

# ✅ CORRECT - Edit source, let generator handle it
manifest = read_json("service.json")
manifest["features"].append("vite-node")
write_file("service.json", json.encode(manifest))
# Generator will update vite config on next Tilt up
```

## Generator Metadata

This AGENTS.md file was auto-generated by:
- **Generator**: `engine/topologies/tilt/generators/agents_md.star`
- **Orchestrator**: `manifest_resource.star` (per-manifest config generation)
- **Triggered by**: Changes to `service.json`
- **Generated at**: {timestamp}
- **Resource**: {resource_name}
- **App Type**: {app_type}

## Emergency Override

If you absolutely MUST modify an autogenerated file temporarily:

1. Stop Tilt (`tilt down`)
2. Make your changes
3. Run your tests
4. **CRITICAL**: Move your changes to the source manifest
5. Restart Tilt (`tilt up`)

**Remember**: The `.autogenerated/` folder is a build artifact, not source code.

---

*Generated by TDK Landscape - Manifest-Driven Architecture*
*Do not manually edit this file - it will be regenerated*
"""

# =============================================================================
# 🎯 GENERATOR FUNCTIONS
# =============================================================================

def generate_agents_md(manifest, write_fn=None):
    """
    Generate AGENTS.md for the .autogenerated/ folder.
    
    This file serves as a guard rail to prevent AI agents from accidentally
    modifying machine-generated files. It explains the single source of truth
    principle and directs agents to the correct files to modify.
    
    Args:
        manifest: Resource manifest dict with appName, appType, _resourcePath
        write_fn: Function to write files (resource_path + filename, content)
    
    Returns:
        Generated AGENTS.md content string
    
    Output:
        {resource_path}/.autogenerated/AGENTS.md
    """
    resource_path = manifest.get('_resource_path', '')
    app_name = manifest.get('appName', 'unknown-service')
    app_type = manifest.get('appType', 'backend')
    
    # Get current timestamp for metadata (Starlark doesn't have time module)
    timestamp = "auto-generated"
    
    # Generate header with template info
    header = Utils.get_template_header(
        'agents_md',
        'AgentsMd.generate()',
        app_name,
        'Output: .autogenerated/AGENTS.md',
    )
    
    # Format the template with resource-specific values
    content = TEMPLATE_AGENTS_MD.format(
        header=header,
        resource_name=app_name,
        app_type=app_type,
        timestamp=timestamp,
    )
    
    if write_fn:
        output_path = resource_path + '/' + OUTPUT.AUTOGENERATED_FOLDER + '/AGENTS.md'
        write_fn(output_path, content)
        print("🤖 Generated AGENTS.md for {}".format(app_name))
    
    return content


# =============================================================================
# 🎯 PUBLIC API
# =============================================================================

AgentsMd = struct(
    generate = generate_agents_md,
)
